{"version": 2, "width": 156, "height": 41, "timestamp": 1794578687, "idle_time_limit": 2.0, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "MTS: Metadata transformation demo"}
[0.035721, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.042193, "o", "\r\n\u001b[1;36m# Metadata Transformation Service (MTS)\u001b[0m\r\n\r\n"]
[2.041157, "o", "\r\n\u001b[1;36m# 1. Check service health\u001b[0m\r\n\r\n"]
[4.042969, "o", "\u001b[1;32m$ curl -fsS http://localhost:5000/health | jq\u001b[0m\r\n"]
[4.366703, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"ok\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[4.36843, "o", "\r\n"]
[6.369822, "o", "\r\n\u001b[1;36m# 2. Discover supported schemas and crosswalks\u001b[0m\r\n\r\n"]
[8.370826, "o", "\u001b[1;32m$ curl -fsS http://localhost:5000/api/v1/schemas | jq\u001b[0m\r\n"]
[8.681301, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"schemas\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"formats\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n        \u001b[0;32m\"xml\"\u001b[0m\u001b[1;39m,\r\n        \u001b[0;32m\"json\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"datacite-4.1\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"4.1\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"formats\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n        \u001b[0;32m\"xml\"\u001b[0m\u001b[1;39m,\r\n        \u001b[0;32m\"json\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"oai-dc\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"2.0\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[8.681584, "o", "\r\n"]
[10.684108, "o", "\u001b[1;32m$ curl -fsS http://localhost:5000/api/v1/crosswalks | jq\u001b[0m\r\n"]
[11.006494, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"crosswalks\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"datacite-to-dc\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"notes\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n        \u001b[0;32m\"Example maps identifier, creators, titles, publisher, publication year and general resource type only; other fields and qualifiers are omitted.\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"source_schema\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"datacite-4.1\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"supported_input_formats\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n        \u001b[0;32m\"json\"\u001b[0m\u001b[1;39m,\r\n        \u001b[0;32m\"xml\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"supported_output_formats\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n        \u001b[0;32m\"json\"\u001b[0m\u001b[1;39m,\r\n        \u001b[0;32m\"xml\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"target_schema\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"oai-dc\"\u001b[0m\u001b[1;39m,\r\n"]
[11.006768, "o", "      \u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"1.0.0\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"dc-to-datacite\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"notes\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n        \u001b[0;32m\"Example maps identifier, creators, titles, publisher, date and type only. Identifier must be a DOI, date a year, and type a DataCite general resource type.\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"source_schema\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"oai-dc\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"supported_input_formats\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n        \u001b[0;32m\"json\"\u001b[0m\u001b[1;39m,\r\n        \u001b[0;32m\"xml\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"supported_output_formats\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n"]
[11.006997, "o", "        \u001b[0;32m\"json\"\u001b[0m\u001b[1;39m,\r\n        \u001b[0;32m\"xml\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"target_schema\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"datacite-4.1\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"1.0.0\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[11.009866, "o", "\r\n"]
[13.014508, "o", "\r\n\u001b[1;36m# 3. Discover available converters and capabilities\u001b[0m\r\n\r\n"]
[15.016469, "o", "\u001b[1;32m$ curl -fsS http://localhost:5000/api/v1/converters | jq\u001b[0m\r\n"]
[15.327985, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"converters\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"datacite-xml-to-json-v1\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"input_format\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"xml\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"notes\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"output_format\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"json\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"schema\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"datacite-4.1\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"1.0.0\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"datacite-json-to-xml-v1\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"input_format\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"json\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"notes\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"output_format\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"xml\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"schema\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"datacite-4.1\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"1.0.0\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"dc-xml-to-json-v1\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"input_format\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"xml\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"notes\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"output_format\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"json\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"schema\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"oai-dc\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"1.0.0\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"dc-json-to-xml-v1\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"input_format\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"json\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"notes\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"output_format\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"xml\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"schema\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"oai-dc\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"1.0.0\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[15.328587, "o", "\r\n"]
[17.330551, "o", "\u001b[1;32m$ curl -fsS http://localhost:5000/api/v1/capabilities | jq\u001b[0m\r\n"]
[17.641026, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"input_formats\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[0;32m\"json\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0;32m\"xml\"\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"max_metadata_bytes\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m1000000\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"max_request_bytes\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m2000000\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"media_types\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n    \u001b[0m\u001b[1;34m\"json\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"application/json\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"xml\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"application/xml\"\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"output_formats\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[0;32m\"json\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0;32m\"xml\"\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[17.642028, "o", "\r\n"]
[19.645806, "o", "\r\n\u001b[1;36m# 4. DataCite XML to Dublin Core XML\u001b[0m\r\n\r\n"]
[21.64816, "o", "\u001b[1;32m$ curl -fsS http://localhost:5000/api/v1/transform -F source_schema=datacite-4.1 -F target_schema=oai-dc -F file=@examples/inputs/datacite.xml | jq -r '.metadata'\u001b[0m\r\n"]
[22.126091, "o", "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n<oai_dc:dc xmlns:oai_dc=\"http://www.openarchives.org/OAI/2.0/oai_dc/\">\r\n   <dc:identifier xmlns:dc=\"http://purl.org/dc/elements/1.1/\">10.1234/mts-example</dc:identifier>\r\n   <dc:creator xmlns:dc=\"http://purl.org/dc/elements/1.1/\">Wijngaarden, Marcella</dc:creator>\r\n   <dc:title xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xml:lang=\"en\">Example research dataset</dc:title>\r\n   <dc:publisher xmlns:dc=\"http://purl.org/dc/elements/1.1/\">Example Research Institute</dc:publisher>\r\n   <dc:date xmlns:dc=\"http://purl.org/dc/elements/1.1/\">2026</dc:date>\r\n   <dc:type xmlns:dc=\"http://purl.org/dc/elements/1.1/\">Dataset</dc:type>\r\n</oai_dc:dc>\r\n\r\n"]
[22.127358, "o", "\r\n"]
[24.129618, "o", "\r\n\u001b[1;36m# 5. DataCite JSON to Dublin Core JSON\u001b[0m\r\n\r\n"]
[26.133317, "o", "\u001b[1;32m$ curl -fsS http://localhost:5000/api/v1/transform -F source_schema=datacite-4.1 -F target_schema=oai-dc -F input_format=json -F output_format=json -F file=@examples/inputs/datacite.json | jq -r '.metadata' | jq\u001b[0m\r\n"]
[26.524174, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"identifier\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"10.1234/mts-example\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"creator\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Wijngaarden, Marcella\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"title\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Example research dataset\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"publisher\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Example Research Institute\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"date\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"2026\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"type\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Dataset\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[26.524393, "o", "\r\n"]
[28.526361, "o", "\r\n\u001b[1;36m# 6. DataCite JSON to Dublin Core XML\u001b[0m\r\n\r\n"]
[30.529089, "o", "\u001b[1;32m$ curl -fsS http://localhost:5000/api/v1/transform -F source_schema=datacite-4.1 -F target_schema=oai-dc -F input_format=json -F output_format=xml -F file=@examples/inputs/datacite.json | jq -r '.metadata'\u001b[0m\r\n"]
[31.023178, "o", "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n<oai_dc:dc xmlns:oai_dc=\"http://www.openarchives.org/OAI/2.0/oai_dc/\">\r\n   <dc:identifier xmlns:dc=\"http://purl.org/dc/elements/1.1/\">10.1234/mts-example</dc:identifier>\r\n   <dc:creator xmlns:dc=\"http://purl.org/dc/elements/1.1/\">Wijngaarden, Marcella</dc:creator>\r\n   <dc:title xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xml:lang=\"en\">Example research dataset</dc:title>\r\n   <dc:publisher xmlns:dc=\"http://purl.org/dc/elements/1.1/\">Example Research Institute</dc:publisher>\r\n   <dc:date xmlns:dc=\"http://purl.org/dc/elements/1.1/\">2026</dc:date>\r\n   <dc:type xmlns:dc=\"http://purl.org/dc/elements/1.1/\">Dataset</dc:type>\r\n</oai_dc:dc>\r\n\r\n"]
[31.024229, "o", "\r\n"]
[33.02616, "o", "\r\n\u001b[1;36m# 7. Reverse crosswalk: Dublin Core XML to DataCite JSON\u001b[0m\r\n\r\n"]
[35.028366, "o", "\u001b[1;32m$ curl -fsS http://localhost:5000/api/v1/transform -F source_schema=oai-dc -F target_schema=datacite-4.1 -F input_format=xml -F output_format=json -F file=@examples/inputs/dublincore.xml | jq -r '.metadata' | jq\u001b[0m\r\n"]
[35.391744, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"identifier\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n    \u001b[0m\u001b[1;34m\"identifier\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"10.1234/mts-example\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"identifierType\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"DOI\"\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"creators\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"creatorName\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Wijngaarden, Marcella\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"titles\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"title\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Example research dataset\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"lang\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"en\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"publisher\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Example Research Institute\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"publicationYear\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"2026\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"resourceType\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n    \u001b[0m\u001b[1;34m\"resourceType\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Dataset\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"resourceTypeGeneral\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Dataset\"\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[35.392018, "o", "\r\n"]
[37.395388, "o", "\r\n\u001b[1;36m# 8. Convert JSON to XML without a crosswalk\u001b[0m\r\n\r\n"]
[39.398892, "o", "\u001b[1;32m$ curl -fsS http://localhost:5000/api/v1/transform -F source_schema=oai-dc -F target_schema=oai-dc -F input_format=json -F output_format=xml -F file=@examples/inputs/dublincore.json | jq '{metadata, report}'\u001b[0m\r\n"]
[39.746916, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"metadata\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\\n<oai_dc:dc xmlns:oai_dc=\\\"http://www.openarchives.org/OAI/2.0/oai_dc/\\\">\\n   <dc:creator xmlns:dc=\\\"http://purl.org/dc/elements/1.1/\\\">Wijngaarden, Marcella</dc:creator>\\n   <dc:date xmlns:dc=\\\"http://purl.org/dc/elements/1.1/\\\">2026</dc:date>\\n   <dc:identifier xmlns:dc=\\\"http://purl.org/dc/elements/1.1/\\\">10.1234/mts-example</dc:identifier>\\n   <dc:publisher xmlns:dc=\\\"http://purl.org/dc/elements/1.1/\\\">Example Research Institute</dc:publisher>\\n   <dc:title xmlns:dc=\\\"http://purl.org/dc/elements/1.1/\\\">Example research dataset</dc:title>\\n   <dc:type xmlns:dc=\\\"http://purl.org/dc/elements/1.1/\\\">Dataset</dc:type>\\n</oai_dc:dc>\\n\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"report\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n    \u001b[0m\u001b[1;34m\"conversions\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n      \u001b[1;39m{\r\n        \u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"dc-json-to-xml-v1\"\u001b[0m\u001b[1;39m,\r\n        \u001b[0m\u001b[1;34m\"notes\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\r\n        \u001b[0m\u001b[1;34m\"source\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"local\"\u001b[0m\u001b[1;39m,\r\n        \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"output_conversion\"\u001b[0m\u001b[1;39m,\r\n        \u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"1.0.0\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"crosswalk\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"schema_transformation\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39mfalse\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"serialization_transformation\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\r\n"]
[39.747111, "o", "    \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"success\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"steps\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n      \u001b[1;39m{\r\n        \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"source_validation\"\u001b[0m\u001b[1;39m,\r\n        \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"passed\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n      \u001b[1;39m{\r\n        \u001b[0m\u001b[1;34m\"operation_id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"dc-json-to-xml-v1\"\u001b[0m\u001b[1;39m,\r\n        \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"output_conversion\"\u001b[0m\u001b[1;39m,\r\n        \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"passed\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n      \u001b[1;39m{\r\n        \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"target_validation\"\u001b[0m\u001b[1;39m,\r\n        \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"passed\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"warnings\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[39.747751, "o", "\r\n"]
[41.750264, "o", "\r\n\u001b[1;36m# 9. Inspect the transformation report\u001b[0m\r\n\r\n"]
[43.758285, "o", "\u001b[1;32m$ curl -fsS http://localhost:5000/api/v1/transform -F source_schema=datacite-4.1 -F target_schema=oai-dc -F input_format=json -F output_format=json -F file=@examples/inputs/datacite.json | jq '.report'\u001b[0m\r\n"]
[44.135975, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"conversions\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"datacite-json-to-xml-v1\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"notes\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"source\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"local\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"input_conversion\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"1.0.0\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"dc-xml-to-json-v1\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"notes\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"source\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"local\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"output_conversion\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"1.0.0\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"crosswalk\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n    \u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"datacite-to-dc\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"notes\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n      \u001b[0;32m\"Example maps identifier, creators, titles, publisher, publication year and general resource type only; other fields and qualifiers are omitted.\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"source\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"local\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"1.0.0\"\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"schema_transformation\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"serialization_transformation\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"success_with_warnings\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"steps\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"source_validation\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"passed\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"crosswalk_id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"datacite-to-dc\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"crosswalk_selection\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"passed\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"operation_id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"datacite-json-to-xml-v1\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"input_conversion\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"passed\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"input_conversion_validation\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"passed\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"operation_id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"datacite-to-dc\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"transformation\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"passed\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"native_target_validation\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"passed\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"operation_id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"dc-xml-to-json-v1\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"output_conversion\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"passed\"\u001b[0m\u001b[1;39m\r\n"]
[44.136183, "o", "    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"target_validation\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"passed\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"warnings\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[0;32m\"Language annotations (xml:lang) were omitted from flat Dublin Core JSON; the resource language field was not inferred.\"\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[44.136729, "o", "\r\n"]
[46.139528, "o", "\r\n\u001b[1;36m# 10. Invalid schema: demonstrate error handling\u001b[0m\r\n\r\n"]
[48.141608, "o", "\u001b[1;32m$ curl -sS http://localhost:5000/api/v1/transform -F source_schema=unknown -F target_schema=oai-dc -F file=@examples/inputs/datacite.xml | jq\u001b[0m\r\n"]
[48.459645, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"error\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n    \u001b[0m\u001b[1;34m\"code\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"unknown_schema\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"Unknown schema: unknown\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"request\"\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"report\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n    \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"failed\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"steps\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n      \u001b[1;39m{\r\n        \u001b[0m\u001b[1;34m\"stage\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"request\"\u001b[0m\u001b[1;39m,\r\n        \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"failed\"\u001b[0m\u001b[1;39m\r\n      \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[48.460557, "o", "\r\n"]
[50.46227, "o", "\r\n\u001b[1;36m# End of MTS demonstration\u001b[0m\r\n\r\n"]
